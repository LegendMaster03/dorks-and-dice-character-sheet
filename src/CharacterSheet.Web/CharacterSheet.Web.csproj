<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <BuildClient Condition="'$(BuildClient)' == ''">true</BuildClient>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../CharacterSheet.Application/CharacterSheet.Application.csproj" />
    <ProjectReference Include="../CharacterSheet.Infrastructure/CharacterSheet.Infrastructure.csproj" />
  </ItemGroup>

  <Target Name="BuildClientApplication"
          BeforeTargets="Build"
          Condition="'$(BuildClient)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/Client"
          Command="npm install --no-audit --no-fund"
          Condition="!Exists('$(MSBuildProjectDirectory)/Client/node_modules')" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/Client"
          Command="npm run build" />
  </Target>
</Project>
